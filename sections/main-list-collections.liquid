<section class="section-spacing">
  <div class="page-width">
    <div class="section-header">
      <p class="eyebrow">Shop by need</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="muted">Printable guides for training, new pet setup, health records, grooming, and cat enrichment.</p>
    </div>
    <div class="card-grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a class="category-card" href="{{ collection.url }}">
            <div class="category-card__image">
              {%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </div>
            <div class="category-card__content"><h3>{{ collection.title }}</h3><p class="muted">{{ collection.products_count }} products</p></div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}{ "name": "Main list collections", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collections for everyday pet care" }] }{% endschema %}
