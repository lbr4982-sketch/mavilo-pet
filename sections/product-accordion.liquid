<section class="section-spacing section-spacing--tight">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <div class="section-header"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
          <summary class="accordion__summary">{{ block.settings.title }}<span class="accordion__icon" aria-hidden="true">+</span></summary>
          <div class="accordion__content richtext">
            {%- if block.settings.use_metafield and block.settings.metafield_key != blank -%}
              {%- assign parts = block.settings.metafield_key | split: '.' -%}
              {%- assign mf = product.metafields[parts[0]][parts[1]] -%}
              {%- if mf != blank -%}{{ mf | metafield_tag }}{%- else -%}{{ block.settings.content }}{%- endif -%}
            {%- else -%}
              {{ block.settings.content }}
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Product accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product details" },
    { "type": "checkbox", "id": "open_first", "label": "Open first item by default", "default": true }
  ],
  "blocks": [
    { "type": "item", "name": "Accordion item", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Materials" },
      { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Made with pet-safe, easy-clean materials selected for everyday use.</p>" },
      { "type": "checkbox", "id": "use_metafield", "label": "Use product metafield when available", "default": false },
      { "type": "text", "id": "metafield_key", "label": "Metafield key (namespace.key)", "info": "Example: custom.materials" }
    ] }
  ],
  "presets": [{ "name": "Product accordion" }]
}
{% endschema %}
