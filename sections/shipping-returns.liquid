<section class="section-spacing">
  <div class="page-width">
    <div class="newsletter" style="background:#fff;border:1px solid var(--color-border);color:var(--color-text)">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="muted">{{ section.settings.text }}</p>
      </div>
      <div class="value-card">
        <h3>{{ section.settings.box_heading }}</h3>
        <p class="muted">{{ section.settings.box_text }}</p>
        <a class="button button--outline" href="{{ section.settings.link | default: '/pages/contact' }}">{{ section.settings.link_label }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shipping and returns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shipping & returns" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clear expectations before checkout" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Use this section to explain expected delivery, tracking, and return policy details for your store." },
    { "type": "text", "id": "box_heading", "label": "Box heading", "default": "Need help with an order?" },
    { "type": "textarea", "id": "box_text", "label": "Box text", "default": "Have your order number ready and contact support for product or delivery questions." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Contact support" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Shipping and returns" }]
}
{% endschema %}
