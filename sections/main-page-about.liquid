<section class="hero">
  <div class="page-width hero__grid">
    <div class="hero__text">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="hero__actions">
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    </div>
    <div class="hero__image">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '500, 800, 1000', alt: section.settings.heading }}
      {%- else -%}
        <div class="hero__placeholder">🐾</div>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="section-spacing">
  <div class="page-width">
    <div class="section-header">
      <p class="eyebrow">{{ section.settings.promise_eyebrow }}</p>
      <h2>{{ section.settings.promise_heading }}</h2>
      <p class="muted">{{ section.settings.promise_text }}</p>
    </div>
    <div class="card-grid">
      {%- for block in section.blocks -%}
        <div class="value-card" {{ block.shopify_attributes }}>
          <p class="eyebrow">{{ block.settings.icon }}</p>
          <h3>{{ block.settings.title }}</h3>
          <p class="muted">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="section-spacing">
  <div class="page-width richtext">
    <h2>{{ page.title }}</h2>
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      <p>Mavilo Pet Co. curates practical pet wellness and lifestyle accessories for U.S. pet parents. We focus on useful products that help with cleaning, grooming, comfort, walking, and travel.</p>
      <p>Our store is organized around everyday routines because pet care is not just cute moments. It is muddy paws, loose fur, daily walks, car rides, bath days, and making home feel easier for everyone.</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "About page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Mavilo Pet Co." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Practical pet products for real everyday routines." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We help pet parents find useful accessories for cleaner homes, easier grooming, calmer comfort, smoother walks, and better travel days." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all products" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/all" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "promise_eyebrow", "label": "Promise eyebrow", "default": "What we look for" },
    { "type": "text", "id": "promise_heading", "label": "Promise heading", "default": "Useful first, pet-parent friendly always" },
    { "type": "textarea", "id": "promise_text", "label": "Promise text", "default": "Every product should support a real pet care moment, from cleanup to comfort." }
  ],
  "blocks": [
    { "type": "value", "name": "Value", "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🧼" },
      { "type": "text", "id": "title", "label": "Title", "default": "Cleaner routines" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Products that help with fur, dirt, paws, and home cleanup." }
    ] }
  ],
  "presets": [
    { "name": "About page", "blocks": [
      { "type": "value", "settings": { "icon": "🧼", "title": "Cleaner routines", "text": "Products that help with fur, dirt, paws, and home cleanup." } },
      { "type": "value", "settings": { "icon": "🐶", "title": "Comfort matters", "text": "Accessories that support rest, calm, and cozy daily life." } },
      { "type": "value", "settings": { "icon": "🚶", "title": "Made for movement", "text": "Walking and travel picks for busy pet households." } },
      { "type": "value", "settings": { "icon": "💚", "title": "No gimmicks", "text": "We prioritize practical usefulness over novelty." } }
    ] }
  ]
}
{% endschema %}
