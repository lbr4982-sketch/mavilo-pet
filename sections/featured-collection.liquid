<section class="section-spacing">
  <div class="page-width">
    <div class="section-header"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="muted">{{ section.settings.text }}</p></div>
    <div class="card-grid">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- for product in collection.products limit: section.settings.limit -%}{% render 'product-card', product: product %}{%- else -%}{%- for i in (1..4) -%}<article class="product-card"><div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><div class="product-card__content"><h3>Practical pet essential</h3><p class="price">$24.99</p><a class="button button--full" href="{{ routes.all_products_collection_url }}">Shop now</a></div></article>{%- endfor -%}{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everyday helpers for pet parents" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Start with customer favorites for tidier homes, easier walks, and more comfortable pets." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 4, "label": "Products", "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
