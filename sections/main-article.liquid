<article class="section-spacing">
  <div class="page-width richtext">
    <p class="eyebrow">{{ blog.title }}</p>
    <h1>{{ article.title }}</h1>
    <p class="muted">{{ article.published_at | date: '%B %d, %Y' }}</p>
    {%- if article.image -%}{{ article.image | image_url: width: 1200 | image_tag: widths: '700, 1000, 1200', alt: article.title }}{%- endif -%}
    {{ article.content }}
  </div>
</article>
{% schema %}{ "name": "Main article" }{% endschema %}
