<section class="section-spacing">
  <div class="page-width">
    <div class="section-header">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="muted">{{ section.settings.text }}</p>
    </div>
    <div class="trust-row" style="margin-top:0">
      {%- for block in section.blocks -%}
        <div class="trust-card" {{ block.shopify_attributes }}>
          <span style="font-size:2rem;color:inherit;margin-bottom:.35rem">{{ block.settings.icon }}</span>
          {{ block.settings.title }}
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop with confidence" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Practical pet essentials, simple buying experience" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Mavilo Pet Co. is built for U.S. pet parents who want useful products without overcomplicated shopping." }
  ],
  "blocks": [
    { "type": "badge", "name": "Badge", "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🚚" },
      { "type": "text", "id": "title", "label": "Title", "default": "U.S. shipping" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Clear checkout for United States customers." }
    ] }
  ],
  "presets": [
    { "name": "Trust badges", "blocks": [
      { "type": "badge", "settings": { "icon": "🚚", "title": "U.S. shipping", "text": "Clear checkout for United States customers." } },
      { "type": "badge", "settings": { "icon": "🔒", "title": "Secure checkout", "text": "Payments are handled through Shopify's secure checkout." } },
      { "type": "badge", "settings": { "icon": "🐾", "title": "Pet routine focused", "text": "Chosen for cleaning, grooming, comfort, walking, and travel." } },
      { "type": "badge", "settings": { "icon": "💬", "title": "Helpful support", "text": "Simple help for product, order, and delivery questions." } }
    ] }
  ]
}
{% endschema %}
