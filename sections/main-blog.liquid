<section class="section-spacing">
  <div class="page-width">
    <div class="section-header"><p class="eyebrow">Mavilo journal</p><h1>{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 9 -%}
      <div class="card-grid">
        {%- for article in blog.articles -%}
          <article class="article-card">
            <a class="article-card__image" href="{{ article.url }}">{%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</a>
            <div class="article-card__content"><h3><a href="{{ article.url }}">{{ article.title }}</a></h3><p class="muted">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p></div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}{ "name": "Main blog" }{% endschema %}
