{%- comment -%}
  Link list ("link in bio" page). Mobile-first stack of big tappable buttons.
  Progressive enhancement: with ?p=<handle> in the URL, the block whose
  data-handle matches is moved to the top and highlighted (pins and videos
  link here as /pages/links?p=<product handle>).
{%- endcomment -%}
<section class="section-spacing section-spacing--tight link-list" id="link-list-{{ section.id }}">
  <div class="page-width link-list__inner">
    <header class="link-list__header">
      {%- if section.settings.show_logo and settings.logo != blank -%}
        <a href="{{ routes.root_url }}" class="link-list__logo" aria-label="{{ shop.name | escape }}">
          {{ settings.logo | image_url: width: 240 | image_tag: widths: '120, 240', alt: shop.name }}
        </a>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="link-list__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="link-list__text muted">{{ section.settings.text }}</p>
      {%- endif -%}
    </header>

    <ul class="link-list__items" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.url == blank or block.settings.label == blank -%}{%- continue -%}{%- endif -%}
        {%- assign is_external = false -%}
        {%- if block.settings.url contains '://' -%}{%- assign is_external = true -%}{%- endif -%}
        <li class="link-list__item{% if block.settings.featured %} is-featured{% endif %}"
            data-handle="{{ block.settings.handle | escape }}"
            {{ block.shopify_attributes }}>
          <a class="link-list__button" href="{{ block.settings.url }}"{% if is_external %} rel="noopener"{% endif %}>
            {%- if block.settings.icon != blank -%}
              <span class="link-list__icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {%- endif -%}
            <span class="link-list__label">
              <strong>{{ block.settings.label }}</strong>
              {%- if block.settings.note != blank -%}<small>{{ block.settings.note }}</small>{%- endif -%}
            </span>
            <span class="link-list__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.footnote != blank -%}
      <p class="link-list__footnote muted">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    try {
      var p = new URLSearchParams(window.location.search).get('p');
      if (!p) return;
      var list = document.querySelector('#link-list-{{ section.id }} .link-list__items');
      if (!list) return;
      var hit = list.querySelector('[data-handle="' + p.replace(/["\\]/g, '') + '"]');
      if (!hit) return;
      hit.classList.add('is-highlighted');
      hit.setAttribute('aria-label', {{ 'sections.link_list.from_pin' | t | json }});
      list.insertBefore(hit, list.firstElementChild);
    } catch (e) { /* no-op: page works without the highlight */ }
  })();
</script>

{% schema %}
{
  "name": "Link list",
  "tag": "section",
  "class": "section-link-list",
  "settings": [
    { "type": "checkbox", "id": "show_logo", "label": "Show logo", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mavilo Pet Co." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Printable pet-care guides: instant PDF downloads, nothing shipped. Tap a link below." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Our guides are general education for pet parents, not veterinary advice." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop all guides" },
        { "type": "url", "id": "url", "label": "URL" },
        { "type": "text", "id": "icon", "label": "Emoji or icon text", "info": "Optional, e.g. 🐾" },
        { "type": "text", "id": "note", "label": "Note", "info": "Optional one-liner under the label" },
        { "type": "text", "id": "handle", "label": "Product handle (for ?p= highlight)", "info": "Pins and videos link to /pages/links?p=<handle>. The matching block jumps to the top." },
        { "type": "checkbox", "id": "featured", "label": "Featured style", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Link list",
      "blocks": [
        { "type": "link", "settings": { "label": "Shop all guides on Etsy", "url": "https://mavilocco.etsy.com", "icon": "🛍️", "note": "Instant PDF download", "featured": true } },
        { "type": "link", "settings": { "label": "Complete Pet Parent Bundle", "url": "/products/complete-pet-parent-bundle", "icon": "📚", "note": "All 5 guides, one download", "handle": "complete-pet-parent-bundle" } },
        { "type": "link", "settings": { "label": "30-Day Puppy Training Plan", "url": "/products/puppy-training-plan", "icon": "🐶", "note": "One short session a day", "handle": "puppy-training-plan" } },
        { "type": "link", "settings": { "label": "Indoor Cat Enrichment Guide", "url": "/products/cat-enrichment-guide", "icon": "🐱", "note": "30 DIY ideas + 4-week calendar", "handle": "cat-enrichment-guide" } },
        { "type": "link", "settings": { "label": "Free \"First Week with Your Puppy\" checklist", "url": "/#newsletter", "icon": "✉️", "note": "Join the newsletter" } },
        { "type": "link", "settings": { "label": "Shopify store home", "url": "/", "icon": "🏠", "note": "All guides, blog and FAQ" } }
      ]
    }
  ]
}
{% endschema %}
