<section class="hero">
  <div class="page-width hero__grid">
    <div class="hero__text">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="hero__actions">
        <a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        <a class="button button--outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      </div>
    </div>
    <div class="hero__image">
      {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1000 | image_tag: widths: '500, 800, 1000', alt: section.settings.heading }}{%- else -%}<div class="hero__placeholder">🐾</div>{%- endif -%}
    </div>
  </div>
</section>
<div class="page-width trust-row">
  <div class="trust-card">Instant download<span>PDF in your inbox right after checkout</span></div>
  <div class="trust-card">Print or tablet<span>US Letter pages, ready to use</span></div>
  <div class="trust-card">Positive methods<span>Reward-based, low-stress routines</span></div>
  <div class="trust-card">Secure checkout<span>Powered by Shopify</span></div>
</div>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pet wellness made practical" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Useful pet products for cleaner, calmer everyday care." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Shop grooming, comfort, walking, cleaning, and travel accessories selected for busy U.S. pet parents." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Shop best sellers" },
    { "type": "url", "id": "primary_link", "label": "Primary link", "default": "/collections/all" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Explore collections" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link", "default": "/collections" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
