<section class="section-spacing">
  <div class="page-width richtext">
    <h1>Create account</h1>
    {%- form 'create_customer', class: 'product-form' -%}
      {{ form.errors | default_errors }}
      <div class="field"><input type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name"></div>
      <div class="field"><input type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name"></div>
      <div class="field"><input type="email" name="customer[email]" autocomplete="email" placeholder="Email" required></div>
      <div class="field"><input type="password" name="customer[password]" autocomplete="new-password" placeholder="Password" required></div>
      <button class="button" type="submit">Create account</button>
    {%- endform -%}
  </div>
</section>
{% schema %}{ "name": "Main register" }{% endschema %}
