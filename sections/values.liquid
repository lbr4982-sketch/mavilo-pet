<section class="section-spacing">
  <div class="page-width">
    <div class="section-header"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    <div class="card-grid">
      {%- for block in section.blocks -%}<div class="value-card" {{ block.shopify_attributes }}><p class="eyebrow">{{ block.settings.icon }}</p><h3>{{ block.settings.title }}</h3><p class="muted">{{ block.settings.text }}</p></div>{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Values",
  "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Mavilo" }, { "type": "text", "id": "heading", "label": "Heading", "default": "Built around practical pet routines" }],
  "blocks": [{ "type": "value", "name": "Value", "settings": [{ "type": "text", "id": "icon", "label": "Icon", "default": "🐶" }, { "type": "text", "id": "title", "label": "Title", "default": "Useful first" }, { "type": "textarea", "id": "text", "label": "Text", "default": "Every product should solve a real cleaning, grooming, comfort, walking, or travel need." }] }],
  "presets": [{ "name": "Values", "blocks": [{"type":"value","settings":{"icon":"🧼","title":"Cleaner homes","text":"Accessories that help manage mess from paws, fur, and daily adventures."}}, {"type":"value","settings":{"icon":"🐾","title":"Comfortable pets","text":"Products chosen for calmer routines and cozy rest."}}, {"type":"value","settings":{"icon":"🚗","title":"Ready to go","text":"Travel-friendly picks for errands, road trips, and weekends away."}}, {"type":"value","settings":{"icon":"🇺🇸","title":"U.S. pet parents","text":"Store messaging, checkout, and offers focused on the United States market."}}] }]
}
{% endschema %}
