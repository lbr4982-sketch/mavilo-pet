{%- comment -%}
  카테고리별 보완 상품 추천: 제품 타입에 따라 어울리는 컬렉션에서 상품을 뽑고,
  부족하면 best-sellers로 채운다. 현재 상품은 제외.
{%- endcomment -%}
{%- liquid
  assign primary_handle = 'best-sellers'
  assign secondary_handle = 'best-sellers'
  case product.type
    when 'Cleaning'
      assign primary_handle = 'cleaning'
      assign secondary_handle = 'grooming'
    when 'Grooming'
      assign primary_handle = 'grooming'
      assign secondary_handle = 'cleaning'
    when 'Comfort'
      assign primary_handle = 'comfort'
      assign secondary_handle = 'travel'
    when 'Walking'
      assign primary_handle = 'walking'
      assign secondary_handle = 'travel'
    when 'Travel'
      assign primary_handle = 'travel'
      assign secondary_handle = 'walking'
  endcase
  assign limit = section.settings.limit
-%}
<section class="section-spacing">
  <div class="page-width">
    <div class="section-header">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="muted">{{ section.settings.text }}</p>
    </div>
    <div class="card-grid">
      {%- assign shown = 0 -%}
      {%- assign shown_handles = product.handle -%}
      {%- for source in (1..3) -%}
        {%- case source -%}
          {%- when 1 -%}{%- assign coll = collections[primary_handle] -%}
          {%- when 2 -%}{%- assign coll = collections[secondary_handle] -%}
          {%- when 3 -%}{%- assign coll = collections['best-sellers'] -%}
        {%- endcase -%}
        {%- for item in coll.products -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- unless shown_handles contains item.handle -%}
            {%- assign shown_handles = shown_handles | append: ',' | append: item.handle -%}
            {%- assign shown = shown | plus: 1 -%}
            {% render 'product-card', product: item %}
          {%- endunless -%}
        {%- endfor -%}
        {%- if shown >= limit -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Complete the routine",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Goes well together" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the routine" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pair it with everyday helpers pet parents reach for most." },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 }
  ],
  "presets": [{ "name": "Complete the routine" }]
}
{% endschema %}
